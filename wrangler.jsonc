{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spx-setups",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "routes": [
    { "pattern": "setups.myspx.trade", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
